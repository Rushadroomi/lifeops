# ─────────────────────────────────────────────────────────────────────────────
#  LifeOps — Environment Variables
#  Copy this to .env and fill in your values.
#  NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL password (used by both DB and n8n)
DB_PASSWORD=your_strong_password_here

# A long random string — used to protect all API endpoints
# Generate one: openssl rand -hex 32
LIFEOPS_API_KEY=your_api_key_here

# n8n login credentials
N8N_USER=your@email.com
N8N_PASSWORD=your_n8n_password_here

# Your Cloudflare Tunnel or ngrok public URL for n8n webhooks
N8N_PUBLIC_URL=https://your-tunnel.trycloudflare.com

# Ollama (optional — defaults to host.docker.internal:11434)
# OLLAMA_URL=http://host.docker.internal:11434
